# RFC 3339: the pieces a timestamp is made of, and the shapes the parser
# refuses.
#
# The refusals are the point. Widths, an impossible calendar date and a negative
# field are what got through before this parser was tightened, and each is a
# token away from a valid timestamp rather than a document away.

"+"
"+00:00"
"+2026"
"-"
"-05:00"
"-1"
"."
".000000"
".999999999"
"00"
"0000"
"0000-01-01T00:00:00Z"
"1970-01-01T00:00:00Z"
"2016-12-31T23:59:60Z"
"2024-02-29"
"2026"
"2026-02-02T02:40:00.123456Z"
"2026-02-31"
"23"
"59"
"60"
"61"
"99"
"9999"
"9999-12-31T23:59:59Z"
":"
"T"
"Z"
"t"
"z"
