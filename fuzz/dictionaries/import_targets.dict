# Target files: the expression grammar, and the first bytes that make each
# format recognisable.
#
# The CSV header is this crate's own and is what `ImportFormat::sniff` matches a
# table against, so it is taken from `format::csv::COLUMNS` rather than typed
# out. The rest is the target grammar: a fuzzer that cannot spell a CIDR block
# never reaches the code that expands one.

"#"
"%eth0"
","
"-"
"/"
"0.0.0.0/0"
"1-1024"
"10.0.0.0/8"
"10.0.0.1-10.0.0.9"
"192.168.0.1"
"2001:db8::1"
"80,443"
":"
"::/0"
"<nmaprun"
"["
"[2001:db8::1]:443"
"]"
"alive"
"cert_common_name"
"cert_not_after"
"discovery_reason"
"findings"
"first_seen"
"hostname"
"ip"
"ip,hostname,status,alive,ips,mac,mac_vendor,os,os_accuracy,roles,rtt_median_us,first_seen,last_seen,port,protocol,state,service,service_product,service_version,service_confidence,discovery_reason,tls_version,cert_common_name,cert_not_after,findings"
"ips"
"last_seen"
"mac"
"mac_vendor"
"os"
"os_accuracy"
"port"
"protocol"
"roles"
"rtt_median_us"
"service"
"service_confidence"
"service_product"
"service_version"
"state"
"status"
"tls_version"
"u:"
"u:53"
"{\"schema_version\":1,\"hosts\":["
"{\"type\":\"report\""
"\xef\xbb\xbf"
